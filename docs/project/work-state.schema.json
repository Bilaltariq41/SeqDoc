{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeqDoc canonical work state",
  "type": "object",
  "required": ["schemaVersion", "id", "kind", "title", "owner", "track", "lifecycle", "dependencies", "contractRevision", "baseline", "checkpointId", "checkpointPath", "branch", "pr", "selectedForExecution", "nextAction", "expectedGithubState", "lifecycleLabel", "statusReason"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^(GH-[0-9]+|[A-Za-z][A-Za-z0-9-]*)$"},
    "kind": {"enum": ["github-issue", "parent", "acceptance", "synthetic"]},
    "number": {"type": "integer", "minimum": 1},
    "sourceUrl": {"type": "string", "format": "uri"},
    "title": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "track": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["Draft", "Blocked", "Ready", "Active", "ReviewRequired", "ResolvingFindings", "Verifying", "Closed", "Cancelled"]},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "contractRevision": {"type": ["string", "null"]},
    "baseline": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "checkpointId": {"type": ["string", "null"]},
    "checkpointPath": {"type": ["string", "null"]},
    "branch": {"type": ["string", "null"]},
    "pr": {"type": ["string", "null"]},
    "selectedForExecution": {"type": "boolean"},
    "nextAction": {"type": ["string", "null"]},
    "expectedGithubState": {"enum": ["OPEN", "CLOSED", "NONE"]},
    "lifecycleLabel": {"type": ["string", "null"]},
    "statusReason": {"type": "string", "minLength": 1},
    "executionId": {"type": "string", "minLength": 1},
    "worktreeId": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "items": {"type": "object", "required": ["kind", "value"], "properties": {"kind": {"enum": ["path", "fixture", "governance-tool", "exclusive"]}, "value": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "reviewEpoch": {"type": "string", "minLength": 1},
    "reviewPeer": {"type": "string", "minLength": 1},
    "reviewFindings": {"type": "array", "items": {"type": "string"}},
    "review": {"type": "object", "required": ["executionId", "pr", "requestHead", "author", "peer", "epoch", "findings"], "additionalProperties": false, "properties": {"executionId": {"type": "string"}, "pr": {"type": "string"}, "requestHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "author": {"type": "string"}, "peer": {"type": "string"}, "epoch": {"type": "string", "pattern": "^[0-9]+$"}, "findings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
    "closeout": {"type": "object", "required": ["executionId", "pr", "head", "mergeSha", "focused", "final", "attribution", "findings"], "additionalProperties": false, "properties": {"executionId": {"type": "string"}, "pr": {"type": "string"}, "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "mergeSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "focused": {"type": "string", "minLength": 1}, "final": {"type": "string", "minLength": 1}, "attribution": {"type": "string", "minLength": 1}, "findings": {"type": "array", "const": ["resolved"]}}},
    "takeover": {"oneOf": [{"type": "object", "required": ["authorizationReceipt", "reason", "startHead"], "additionalProperties": false, "properties": {"authorizationReceipt": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "startHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}, {"type": "object", "required": ["mode", "authorizationReceipt", "authorizationDigest", "authorizedBy", "reason", "startHead"], "additionalProperties": false, "properties": {"mode": {"const": "owner"}, "authorizationReceipt": {"type": "string", "minLength": 1}, "authorizationDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "authorizedBy": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "startHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}, {"type": "object", "required": ["mode", "authorizationHead", "authorizationReceipts", "reason", "startHead"], "additionalProperties": false, "properties": {"mode": {"const": "two-peer"}, "authorizationHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "authorizationReceipts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["url", "authorizationDigest", "authorizedBy"], "additionalProperties": false, "properties": {"url": {"type": "string", "format": "uri"}, "authorizationDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "authorizedBy": {"type": "string", "minLength": 1}}}}, "reason": {"type": "string", "minLength": 1}, "startHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}]},
    "resume": {"type": "object", "required": ["reason", "startHead"], "additionalProperties": false, "properties": {"reason": {"type": "string", "minLength": 1}, "startHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}
  },
  "additionalProperties": false,
  "allOf": [{"if": {"required": ["takeover"]}, "then": {"properties": {"lifecycle": {"const": "Blocked"}}}}]
}
