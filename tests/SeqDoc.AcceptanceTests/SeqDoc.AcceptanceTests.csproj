<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\SeqDoc.Cli\SeqDoc.Cli.csproj" />
    <ProjectReference Include="..\..\src\SeqDoc.Application\SeqDoc.Application.csproj" />
    <ProjectReference Include="..\..\src\SeqDoc.Core\SeqDoc.Core.csproj" />
    <!-- GH-106/I100-A: builds the deterministic test-child ahead of ProcessOwnershipTests.cs. The
         primitive under test resolves the stub's built exe path at run time (see
         ProcessOwnershipTests.cs's ResolveStubExecutablePath) rather than via a compile-time asset
         reference, so this reference carries zero shared-type dependency. -->
    <ProjectReference Include="..\SeqDoc.AcceptanceTests.ProcessOwnershipStub\SeqDoc.AcceptanceTests.ProcessOwnershipStub.csproj"
                       ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <!-- GH-106/I100-A finalized contract decision 3: unsafe pointer construction for the
         PROC_THREAD_ATTRIBUTE_LIST handle-inheritance restriction and job-object completion-port
         buffers in ProcessOwnership.cs. Never set on the stub project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SeqDoc.Testing\ExternalCorpusResolver.cs" Link="ExternalCorpusResolver.cs" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

</Project>
